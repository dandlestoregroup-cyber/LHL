# APP_URL: Public URL of the deployed Little Hut Light service.
APP_URL="https://YOUR_LHL_HOST"

# Firebase Auth REST API key. This is used server-side for email/password identity.
# Do not expose service-account credentials to the browser.
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"

# Firestore project used for truth-only Live records.
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# Service account used only by the Node server to read/write Live Firestore records.
FIREBASE_SERVICE_ACCOUNT_EMAIL="service-account@YOUR_PROJECT.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# 32+ random bytes used to HMAC-sign HttpOnly Live sessions.
LHL_SESSION_SECRET="REPLACE_WITH_32_PLUS_RANDOM_BYTES"

# The only email allowed to create the initial account before invitations exist.
# After sign-in this identity may bootstrap exactly one first Live Scout Partner record.
LHL_BOOTSTRAP_EMAIL="owner@example.com"

# ACTIVEPIECES_WEBHOOK_URL: Catch Webhook URL for the LHL automation flow.
# Server-only. Never expose this as a VITE_* variable.
ACTIVEPIECES_WEBHOOK_URL="https://YOUR_ACTIVEPIECES_HOST/api/v1/webhooks/..."

# ACTIVEPIECES_SHARED_SECRET: 32+ random bytes shared with the Activepieces
# verification step. Server-only. HMAC-signs both Demo gateway events and durable Live outbox events.
ACTIVEPIECES_SHARED_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Separate 32+ random bytes required by the internal Live outbox drain endpoint.
# A scheduler may POST /api/internal/live-outbox/drain with x-lhl-outbox-secret.
LHL_OUTBOX_SECRET="REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"

# Optional per-IP Demo automation ingress ceiling per minute.
AUTOMATION_RATE_LIMIT="30"
